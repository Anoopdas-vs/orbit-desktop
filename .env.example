# ==============================================================================
# Orbit Assistant - Local Configuration Example (.env.example)
# IMPORTANT: Never commit actual keys, tokens, or passwords to git.
# Sensitive keys must be stored in macOS Keychain, not in plaintext files.
# ==============================================================================

# Application Environment
VITE_APP_ENV=development
VITE_ENABLE_MOCK_MODE=true

# Local Ollama AI Settings
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2:latest

# Voice & STT Engine
# Options: web-speech, whisper-cpp, mock
VITE_VOICE_PROVIDER=web-speech
VITE_WHISPER_CPP_PATH=/usr/local/bin/whisper-cli

# GitHub Integration (Mock by default. Real token goes in macOS Keychain)
VITE_GITHUB_MOCK_MODE=true
# GITHUB_TOKEN=YOUR_KEYCHAIN_STORED_TOKEN

# Deployment Target (Mock by default)
VITE_DEPLOY_PROVIDER=mock
VITE_DEPLOY_WEBHOOK_URL=https://api.deployment-provider.example/v1/deploy

# Binance Trading Module (Strictly read-only or paper by default)
# Valid modes: OFF, READ_ONLY, PAPER_TRADING, LIVE_SPOT_CONFIRMATION_REQUIRED
VITE_TRADING_MODE=PAPER_TRADING
VITE_BINANCE_API_KEY_KEYCHAIN_ID=orbit.binance.apiKey
VITE_BINANCE_API_SECRET_KEYCHAIN_ID=orbit.binance.apiSecret
VITE_BINANCE_TESTNET=true
VITE_TRADING_MAX_ORDER_INR=1000
VITE_TRADING_DAILY_LIMIT_INR=5000
VITE_TRADING_ALLOWED_PAIRS=BTCUSDT,ETHUSDT

# Safety & Kill Switch
VITE_KILL_SWITCH_ACTIVE=false
VITE_REQUIRE_TYPED_CONFIRMATION_CRITICAL=true
